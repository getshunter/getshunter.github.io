flows:
- id: main
  working-directory: ${FlowbookDir}
  name: Node checks
  description: Run each Node syntax check, then the test suite.
  tasks:
  - id: label-lint
    type: comment
    name: Check sample JavaScript syntax
    properties:
      comment: Check sample JavaScript syntax
    description: The original lint script checks both files; this direct check is separate so the remaining checks still run after a failure.
  - id: lint
    type: run-command
    properties:
      command: node --check sample/slug.js
    stop-on-failure: false
    fail-run-on-failure: true
  - id: spacer-before-label-test-syntax
    type: comment
    properties:
      comment: ''
  - id: label-test-syntax
    type: comment
    name: Check test JavaScript syntax
    properties:
      comment: Check test JavaScript syntax
    description: This is the second direct check from the original lint script; both checks are independent.
  - id: lint-test
    type: run-command
    properties:
      command: node --check test/slug.test.js
    stop-on-failure: false
    fail-run-on-failure: true
  - id: spacer-before-label-report-directory
    type: comment
    properties:
      comment: ''
  - id: label-report-directory
    type: comment
    name: Create the local report directory
    properties:
      comment: Create the local report directory
  - id: create-report-directory
    type: create-directory
    properties:
      directory: .shunter
  - id: spacer-before-label-tests
    type: comment
    properties:
      comment: ''
  - id: label-tests
    type: comment
    name: Run Node tests
    properties:
      comment: Run Node tests
    description: The JUnit reporter flag is the allowed reporting addition to the upstream test command.
  - id: tests
    type: run-command
    properties:
      command: node --test --test-reporter=junit --test-reporter-destination=.shunter/report.xml
    artifacts:
    - type: junit
      path: .shunter/report.xml
