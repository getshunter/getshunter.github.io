flows:
- id: main
  working-directory: ${FlowbookDir}
  name: Python checks
  description: Run Ruff and pytest independently for local development.
  tasks:
  - id: label-lint
    type: comment
    name: Run Python lint checks
    properties:
      comment: Run Python lint checks
    description: The original GitHub Actions step used this command.
  - id: lint
    type: run-command
    properties:
      command: ruff check sample tests
    stop-on-failure: false
    fail-run-on-failure: true
  - id: spacer-before-label-report-directory
    type: comment
    properties:
      comment: ''
  - id: label-report-directory
    type: comment
    name: Create the local report directory
    properties:
      comment: Create the local report directory
  - id: create-report-directory
    type: create-directory
    properties:
      directory: .shunter
  - id: spacer-before-label-tests
    type: comment
    properties:
      comment: ''
  - id: label-tests
    type: comment
    name: Run Python tests
    properties:
      comment: Run Python tests
    description: The JUnit flag is the allowed reporting addition to the upstream test command.
  - id: tests
    type: run-command
    properties:
      command: python -m pytest --junitxml=.shunter/report.xml
    artifacts:
    - type: junit
      path: .shunter/report.xml
