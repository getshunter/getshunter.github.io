// Generated by Shunter. Installs Shunt and archives its run log.
pipeline {
  agent { label 'linux' }
  environment { SHUNTER_REPOSITORY = 'getshunter/shunter' }
  stages {
    stage('Shunter') { steps { sh 'set -eu\nmkdir -p .shunter\ncurl --fail --location --retry 3 --proto \'=https\' --tlsv1.2 \'https://raw.githubusercontent.com/getshunter/shunter-action/main/install.sh\' -o .shunter/install.sh\nrunner="$(sh .shunter/install.sh \'0.2.4.1107\')"\n"$runner" \'casino.flowbook\' --flow \'build\' --html-log .shunter/Shunter-run-log.html --ci jenkins' } }
  }
  post {
    always {
      archiveArtifacts artifacts: '.shunter/Shunter-run-log.html,.shunter/Shunter-run-log.json,.shunter/Shunter-run-log.md,.shunter/Shunter-run-log.junit,.shunter/artifacts/**', allowEmptyArchive: true, excludes: '**/.flow-artifact-owner'
      script {
        if (env.BUILD_URL && fileExists('.shunter/Shunter-run-log.html')) {
          echo "Shunter log artifact: ${env.BUILD_URL}artifact/.shunter/Shunter-run-log.html"
        }
        if (fileExists('.shunter/Shunter-run-log.junit')) {
          def paths = readFile('.shunter/Shunter-run-log.junit').trim()
          if (paths) {
            def junitFiles = paths.split('\n').collect { '.shunter/' + it }
            junit testResults: junitFiles.join(','), allowEmptyResults: false, keepTestNames: true, skipPublishingChecks: true
          }
        }
      }
      publishHTML(target: [allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true, reportDir: '.shunter', reportFiles: 'Shunter-run-log.html', includes: 'Shunter-run-log.html,artifacts/**', reportName: 'Open Shunter log'])
    }
  }
}
